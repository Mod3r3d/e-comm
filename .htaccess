# ==============================================================================
# WOODLUXE E-COMMERCE - PRODUCTION APACHE / INFINITYFREE CONFIGURATION
# ==============================================================================

# 1. Default Index File (Direct HTML first for instant response)
DirectoryIndex index.html index.php

# 2. Character Encoding (UTF-8)
AddDefaultCharset UTF-8

# 3. URL Rewriting & Clean URLs (Supports both /admin and /admin.html)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Protect sensitive folders & files
    RewriteRule ^database/.*\.sql$ - [F,L]
    RewriteRule ^docs/ - [F,L]
    RewriteRule ^scratch/ - [F,L]

    # If file or folder exists, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map clean URL to .html file (e.g. /admin -> /admin.html)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 4. MIME Types Configuration
<IfModule mod_mime.c>
    AddType text/html .html .htm
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
    AddType image/svg+xml .svg .svgz
    AddType image/webp .webp
    AddType image/jpeg .jpg .jpeg
    AddType image/png .png
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# 5. GZIP / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# 6. Browser Caching Configuration (Instant Update Mode)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
</IfModule>

# 7. Prevent Aggressive Script Caching
<FilesMatch "\.(html|htm|js|css)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>
