{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Twenty Twenty-Five Child - WOODLUXE",
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "name": "WOODLUXE Navy",
          "slug": "woodluxe-navy",
          "color": "#0c192c"
        },
        {
          "name": "WOODLUXE Amber",
          "slug": "woodluxe-amber",
          "color": "#f4a51d"
        },
        {
          "name": "WOODLUXE Dark Navy",
          "slug": "woodluxe-dark",
          "color": "#070f1a"
        },
        {
          "name": "WOODLUXE Slate White",
          "slug": "woodluxe-light",
          "color": "#f8fafc"
        },
        {
          "name": "WOODLUXE Warm White",
          "slug": "base",
          "color": "#ffffff"
        },
        {
          "name": "WOODLUXE Text Dark",
          "slug": "contrast",
          "color": "#111827"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Plus Jakarta Sans",
          "slug": "plus-jakarta-sans"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--plus-jakarta-sans)"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--woodluxe-amber)",
          "text": "var(--wp--preset--color--woodluxe-navy)"
        },
        "border": {
          "radius": "4px"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--woodluxe-navy)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "WOODLUXE Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "WOODLUXE Footer",
      "area": "footer"
    }
  ]
}
